{
  "manifest_version": 3,
  "name": "Logarium — Add to Library",
  "version": "1.0.0",
  "description": "Add the media page you're viewing to your Logarium library in two clicks, and cache covers from Cloudflare-protected sites.",
  "action": {
    "default_title": "Add to LOG",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "logarium@leweixu.dev",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"]
}
